    {
        "id": "v2_store",
        "type": "function",
        "z": "flow_api2",
        "name": "Simpan + Cek Threshold",
        "func": "var d = msg.payload;\nd.received = new Date().toISOString();\nflow.set('lastSensor', d);\nvar h = flow.get('history') || [];\nh.push(d); if (h.length > 50) h.shift();\nflow.set('history', h);\nvar out1 = {payload: {type: 'sensor', data: d}};\nvar th = flow.get('threshold');\nvar out2 = null;\nif (th !== undefined && th !== null && d.suhu > th) {\n  out2 = {payload: {type: 'alert', suhu: d.suhu, batas: th, time: d.received,\n    message: 'Suhu ' + d.suhu + ' C melewati batas ' + th + ' C'}};\n}\nreturn [out1, out2];",
        "outputs": 2,
        "x": 400,
        "y": 80,
        "wires": [
            [
                "v2_ws_out",
                "v2_dbg_sensor"
            ],
            [
                "v2_ws_out",
                "v2_dbg_alert"
            ]
        ]
    },
