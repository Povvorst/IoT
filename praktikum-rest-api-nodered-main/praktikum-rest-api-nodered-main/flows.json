    {
        "id": "v2_f_kontrol",
        "type": "function",
        "z": "flow_api2",
        "name": "Validasi + Publish",
        "func": "msg.headers={'Access-Control-Allow-Origin':'*'};\nif(msg.req.headers['x-api-key']!=='rahasia123'){msg.statusCode=401;msg.payload={status:'error',message:'API key salah atau tidak ada'};return [msg,null];}\nvar b = msg.payload || {};\nif (!b.device || !b.action) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n  return [msg, null];\n}\nvar cmd = {topic: 'iot/kontrol', payload: b};\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Perintah terkirim', sent: b};\nreturn [msg, cmd];",
        "outputs": 2,
        "x": 400,
        "y": 340,
        "wires": [
