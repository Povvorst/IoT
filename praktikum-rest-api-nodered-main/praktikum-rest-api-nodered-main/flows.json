    {
        "id": "v2_f_th",
        "type": "function",
        "z": "flow_api2",
        "name": "Threshold",
        "func": "msg.headers={'Access-Control-Allow-Origin':'*'};\nif(msg.req.headers['x-api-key']!=='rahasia123'){msg.statusCode=401;msg.payload={status:'error',message:'API key salah atau tidak ada'};return msg;}\nif (msg.req.method === 'GET') {\n  var t = flow.get('threshold');\n  msg.statusCode = 200;\n  msg.payload = {status: 'success', max: (t === undefined ? null : t)};\n  return msg;\n}\nvar raw = msg.payload && msg.payload.max;\nvar m = (raw === undefined || raw === null || raw === '') ? NaN : Number(raw);\nif (!isFinite(m)) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'max wajib berupa angka'};\n  return msg;\n}\nflow.set('threshold', m);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu disimpan', max: m};\nreturn msg;",
        "outputs": 1,
        "x": 400,
        "y": 460,
        "wires": [
            [
                "v2_resp"
            ]
        ]
    },
